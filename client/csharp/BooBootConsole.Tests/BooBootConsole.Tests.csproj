  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BooBootConsole/BooBootConsole.csproj" />
  </ItemGroup>

</Project>
