<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BooBootConsole.MainWindow"
        Title="BooBoot Console" Icon="/Assets/booboot.ico"
        Width="1180" Height="700" MinWidth="400" MinHeight="200">
  <Window.Styles>
    <Style Selector="TabStripItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <WrapPanel DockPanel.Dock="Top" Margin="6" ItemSpacing="6" LineSpacing="6">
      <TextBox Name="UrlBox" Width="240" PlaceholderText="http://booboot.local:8080" VerticalAlignment="Center" />
      <Button Name="ConnectButton" Content="Connect" />
      <Button Name="ControlButton" Content="Take control" IsEnabled="False"
              ToolTip.Tip="Open the session, to type into the console" />
      <Button Name="PowerButton" Content="Power on" IsEnabled="False"
              ToolTip.Tip="Switch the DUT power on or off, while in control" />
      <Button Name="DutButton" Content="DUT" IsEnabled="False"
              ToolTip.Tip="The DUT on the board, the same for everyone: its label, address and details">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnDutPanelOpening" Opened="OnDutPanelOpened">
            <Grid ColumnDefinitions="Auto,340" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="8" ColumnSpacing="8">
              <TextBlock Text="Name" VerticalAlignment="Center" />
              <TextBox Name="DutNameBox" Grid.Column="1" IsReadOnly="True" />
              <TextBlock Grid.Row="1" Text="Address" VerticalAlignment="Center" />
              <TextBox Name="DutAddressBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" />
              <TextBlock Grid.Row="2" Text="Label" VerticalAlignment="Center" />
              <TextBox Name="LabelBox" Grid.Row="2" Grid.Column="1" PlaceholderText="like ZCU102 rev B, bench 3" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Name="SetLabelButton" Content="Set label" IsEnabled="False"
                        ToolTip.Tip="Shown with the name, to everyone. Empty: no label" />
                <TextBlock Name="LabelNote" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" MaxWidth="240" />
              </StackPanel>
              <TextBlock Grid.Row="4" Text="Console" />
              <TextBlock Name="DutConsoleText" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" />
              <TextBlock Grid.Row="5" Text="Power" />
              <TextBlock Name="DutPowerText" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" />
              <TextBlock Grid.Row="6" Text="SD card" />
              <TextBlock Name="DutSdText" Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" />
              <TextBlock Grid.Row="7" Text="Server" />
              <TextBlock Name="DutServerText" Grid.Row="7" Grid.Column="1" TextWrapping="Wrap" />
            </Grid>
          </Flyout>
        </Button.Flyout>
      </Button>
      <Border Width="12" />
      <Button Name="ClearButton" Content="Clear" ToolTip.Tip="Clear the view (Ctrl+L, in control Ctrl+Shift+L)" />
      <Button Name="CopyButton" Content="Copy" ToolTip.Tip="Copy the selection (Ctrl+C)" />
      <Button Name="SaveButton" Content="Save..." ToolTip.Tip="Save all the text to a file (Ctrl+S, in control Ctrl+Shift+S)" />
      <ToggleButton Name="FollowButton" Content="Follow" IsChecked="True"
                    ToolTip.Tip="Show new output as it comes (End)" />
      <Border Width="12" />
      <Button Name="LogButton" Content="Log" ToolTip.Tip="Log files of the console, on this computer">
        <Button.Flyout>
          <MenuFlyout Placement="BottomEdgeAlignedLeft">
            <MenuItem Name="StartLogItem" Header="Start new log" ToolTip.Tip="Log to a new file from now on" />
            <MenuItem Name="StopLogItem" Header="Stop log" IsEnabled="False" />
            <MenuItem Name="OpenLogFolderItem" Header="Open log folder" />
          </MenuFlyout>
        </Button.Flyout>
      </Button>
      <Button Content="Settings">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight" Closed="OnSettingsClosed">
            <Grid ColumnDefinitions="Auto,260" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                  RowSpacing="8" ColumnSpacing="8">
              <TextBlock Text="Log folder" VerticalAlignment="Center" />
              <TextBox Name="LogFolderBox" Grid.Column="1" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Name="BrowseButton" Content="Browse..." />
                <Button Name="OpenFolderButton" Content="Open folder" />
              </StackPanel>
              <TextBlock Grid.Row="2" Text="File name prefix" VerticalAlignment="Center" />
              <TextBox Name="PrefixBox" Grid.Row="2" Grid.Column="1" PlaceholderText="DUT name"
                       ToolTip.Tip="With several DUTs, the DUT name is added to it" />
              <CheckBox Name="LogOnConnectBox" Grid.Row="3" Grid.Column="1"
                        Content="Start a log when connected" />
              <CheckBox Name="NewLogBox" Grid.Row="4" Grid.Column="1"
                        Content="New log file at each power on" />
              <TextBlock Grid.Row="5" Text="Scrollback lines" VerticalAlignment="Center" />
              <NumericUpDown Name="ScrollbackBox" Grid.Row="5" Grid.Column="1" Minimum="1000" Maximum="10000000"
                             Increment="50000" FormatString="0" />
              <TextBlock Grid.Row="6" Text="Text size" VerticalAlignment="Center" />
              <NumericUpDown Name="TextSizeBox" Grid.Row="6" Grid.Column="1" Minimum="6" Maximum="48"
                             Increment="1" FormatString="0" />
              <TextBlock Grid.Row="7" Text="Fonts" VerticalAlignment="Center" />
              <TextBox Name="FontsBox" Grid.Row="7" Grid.Column="1" />
            </Grid>
          </Flyout>
        </Button.Flyout>
      </Button>
    </WrapPanel>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="6,3">
      <TextBlock Name="StatusText" Text="Not connected" TextTrimming="CharacterEllipsis" />
      <TextBlock Name="LogText" Grid.Column="1" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
    </Grid>
    <!-- With several DUTs on the board: a tab for each DUT shown. -->
    <DockPanel Name="TabRow" DockPanel.Dock="Top" IsVisible="False" Margin="6,0">
      <Button Name="DutsButton" DockPanel.Dock="Left" Content="DUTs" VerticalAlignment="Center"
              ToolTip.Tip="Show or hide DUTs of the board">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnDutsOpening">
            <StackPanel Name="DutsList" Spacing="4" />
          </Flyout>
        </Button.Flyout>
      </Button>
      <TabStrip Name="Tabs" Margin="6,0,0,0" />
    </DockPanel>
    <!-- The console views of the DUTs, the one of the current DUT visible. -->
    <Panel Name="Views" />
  </DockPanel>
</Window>
