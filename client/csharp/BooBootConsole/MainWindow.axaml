<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BooBootConsole.MainWindow"
        Title="BooBoot Console" Icon="/Assets/booboot.ico"
        Width="1180" Height="700" MinWidth="400" MinHeight="200">
  <Window.Styles>
    <!-- Compact bars, to leave the room to the consoles. -->
    <Style Selector="DockPanel.toolbar Button, DockPanel.toolbar ToggleButton, Border.dut-bar Button, Border.dut-bar ToggleButton">
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="DockPanel.toolbar TextBox">
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="TabStripItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <!-- The bar of a DUT, above its view. With several DUTs at once, the one that takes the keys is marked. -->
    <Style Selector="Border.dut-bar">
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Background" Value="#14808080" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Grid.split Border.dut-bar.current">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}" />
    </Style>
    <Style Selector="GridSplitter.panes">
      <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <!-- The BooBoot board at the address, and this window. Each DUT has its own bar, above its view. -->
    <DockPanel Classes="toolbar" DockPanel.Dock="Top" Margin="4,3">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
        <!-- The load of the board: network traffic to it and from it, its CPU use, and the space used on its disk. -->
        <StackPanel Name="ActivityPanel" Orientation="Horizontal" Spacing="3" Margin="0,0,8,0" IsVisible="False"
                    Background="Transparent" VerticalAlignment="Center">
          <Path Name="UpArrow" Data="M 5,0 L 10,9 L 0,9 Z" Width="10" Height="9" VerticalAlignment="Center" />
          <Path Name="DownArrow" Data="M 0,0 L 10,0 L 5,9 Z" Width="10" Height="9" VerticalAlignment="Center" />
          <TextBlock Text="CPU" FontSize="11" Opacity="0.7" Margin="8,0,0,0" VerticalAlignment="Center" />
          <Border Width="42" Height="10" BorderThickness="1" BorderBrush="#808080" CornerRadius="2"
                  VerticalAlignment="Center">
            <Border Name="CpuBar" HorizontalAlignment="Left" Width="0" CornerRadius="1" />
          </Border>
          <StackPanel Name="DiskPanel" Orientation="Horizontal" Spacing="3" IsVisible="False">
            <TextBlock Text="Disk" FontSize="11" Opacity="0.7" Margin="8,0,0,0" VerticalAlignment="Center" />
            <Border Width="42" Height="10" BorderThickness="1" BorderBrush="#808080" CornerRadius="2"
                    VerticalAlignment="Center">
              <Border Name="DiskBar" HorizontalAlignment="Left" Width="0" CornerRadius="1" />
            </Border>
          </StackPanel>
        </StackPanel>
        <Button Name="DutsButton" Content="DUTs" IsVisible="False"
                ToolTip.Tip="Show or hide DUTs of the board, and the BooBoot log">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" Opening="OnDutsOpening">
              <StackPanel Name="DutsList" Spacing="4" />
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Name="LayoutButton" Content="Layout" IsVisible="False"
                ToolTip.Tip="One DUT at a time in tabs, or all the DUTs shown at once">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Name="TabsItem" Header="Tabs" ToggleType="Radio" GroupName="layout" />
              <MenuItem Name="ColumnsItem" Header="Side by side" ToggleType="Radio" GroupName="layout" />
              <MenuItem Name="RowsItem" Header="Top and bottom" ToggleType="Radio" GroupName="layout" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Content="Settings">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" Closed="OnSettingsClosed">
              <Grid ColumnDefinitions="Auto,260" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="8" ColumnSpacing="8">
                <TextBlock Text="Log folder" VerticalAlignment="Center" />
                <TextBox Name="LogFolderBox" Grid.Column="1" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <Button Name="BrowseButton" Content="Browse..." />
                  <Button Name="OpenFolderButton" Content="Open folder" />
                </StackPanel>
                <TextBlock Grid.Row="2" Text="File name prefix" VerticalAlignment="Center" />
                <TextBox Name="PrefixBox" Grid.Row="2" Grid.Column="1" PlaceholderText="DUT name"
                         ToolTip.Tip="With several DUTs, the DUT name is added to it" />
                <CheckBox Name="LogOnConnectBox" Grid.Row="3" Grid.Column="1"
                          Content="Start a log when connected" />
                <CheckBox Name="NewLogBox" Grid.Row="4" Grid.Column="1"
                          Content="New log file at each power on" />
                <TextBlock Grid.Row="5" Text="Scrollback lines" VerticalAlignment="Center" />
                <NumericUpDown Name="ScrollbackBox" Grid.Row="5" Grid.Column="1" Minimum="1000" Maximum="10000000"
                               Increment="50000" FormatString="0" />
                <TextBlock Grid.Row="6" Text="Text size" VerticalAlignment="Center" />
                <NumericUpDown Name="TextSizeBox" Grid.Row="6" Grid.Column="1" Minimum="6" Maximum="48"
                               Increment="1" FormatString="0" />
                <TextBlock Grid.Row="7" Text="Fonts" VerticalAlignment="Center" />
                <TextBox Name="FontsBox" Grid.Row="7" Grid.Column="1" />
              </Grid>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
      <TextBox Name="UrlBox" DockPanel.Dock="Left" Width="240" PlaceholderText="http://booboot.local:8080"
               VerticalAlignment="Center" ToolTip.Tip="Address of the BooBoot board, or of one of its DUTs" />
      <Button Name="ConnectButton" DockPanel.Dock="Left" Content="Connect" Margin="4,0,0,0"
              ToolTip.Tip="Watch the DUTs of the board at this address" />
      <TextBlock Name="BoardText" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.75"
                 TextTrimming="CharacterEllipsis" />
    </DockPanel>
    <!-- With several DUTs on the board, shown one at a time: a tab for each DUT shown. -->
    <TabStrip Name="Tabs" DockPanel.Dock="Top" IsVisible="False" Margin="4,0" />
    <!-- The views of the DUTs, each with its bar: the one of the current DUT, or all of them. -->
    <Grid Name="Views">
      <FlyoutBase.AttachedFlyout>
        <Flyout Placement="BottomEdgeAlignedLeft" Opening="OnDutPanelOpening" Opened="OnDutPanelOpened">
          <Grid ColumnDefinitions="Auto,340" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                RowSpacing="8" ColumnSpacing="8">
            <TextBlock Text="Name" VerticalAlignment="Center" />
            <TextBox Name="DutNameBox" Grid.Column="1" IsReadOnly="True" />
            <TextBlock Grid.Row="1" Text="Address" VerticalAlignment="Center" />
            <TextBox Name="DutAddressBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" />
            <TextBlock Grid.Row="2" Text="Label" VerticalAlignment="Center" />
            <TextBox Name="LabelBox" Grid.Row="2" Grid.Column="1" PlaceholderText="like ZCU102 rev B, bench 3" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Name="SetLabelButton" Content="Set label" IsEnabled="False"
                      ToolTip.Tip="Shown with the name, to everyone. Empty: no label" />
              <TextBlock Name="LabelNote" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" MaxWidth="240" />
            </StackPanel>
            <TextBlock Grid.Row="4" Text="Console" />
            <TextBlock Name="DutConsoleText" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" />
            <TextBlock Grid.Row="5" Text="Power" />
            <TextBlock Name="DutPowerText" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" />
            <TextBlock Grid.Row="6" Text="SD card" />
            <TextBlock Name="DutSdText" Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" />
            <TextBlock Grid.Row="7" Text="Server" />
            <TextBlock Name="DutServerText" Grid.Row="7" Grid.Column="1" TextWrapping="Wrap" />
          </Grid>
        </Flyout>
      </FlyoutBase.AttachedFlyout>
    </Grid>
  </DockPanel>
</Window>
